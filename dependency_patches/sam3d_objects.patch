+def depth_edge(
+    depth: np.ndarray,
+    rtol: float = 0.03,
+    mask: Optional[np.ndarray] = None,
+) -> np.ndarray:
+    """
+    简化版 depth_edge：
+    标记那些与 4 邻域相比 depth 变化很大的像素。
+    """
+    assert depth.ndim == 2, depth.shape
+    m = _safe_mask(mask, depth.shape)
+    H, W = depth.shape
+    edge = np.zeros_like(depth, dtype=bool)
+
+    for y in range(H):
+        for x in range(W):
+            if not m[y, x]:
+                continue
+            z = depth[y, x]
+            if not np.isfinite(z):
+                continue
+            neighbors = []
+            if x > 0 and m[y, x - 1]:
+                neighbors.append(depth[y, x - 1])
+            if x < W - 1 and m[y, x + 1]:
+                neighbors.append(depth[y, x + 1])
+            if y > 0 and m[y - 1, x]:
+                neighbors.append(depth[y - 1, x])
+            if y < H - 1 and m[y + 1, x]:
+                neighbors.append(depth[y + 1, x])
+            if not neighbors:
+                continue
+            for z2 in neighbors:
+                if not np.isfinite(z2):
+                    continue
+                if abs(z2 - z) > rtol * max(abs(z), abs(z2), 1e-6):
+                    edge[y, x] = True
+                    break
+    return edge
+
