+def open3d_visualizer(
+    ply_path: str,
+    window_name: str = "3D Gaussian Splatting (Open3D)",
+    width: int = 1024,
+    height: int = 768,
+):
+    """Local viewer using Open3D instead of Kaolin.
+
+    Args:
+        ply_path: Path to the .ply file (point cloud or mesh).
+        window_name: Window title.
+        width: Window width in pixels.
+        height: Window height in pixels.
+    """
+    if o3d is None:
+        raise ImportError(
+            "open3d is not installed. Please install it with `pip install open3d`."
+        )
+
+    # Try to load as mesh first; if empty, fall back to point cloud.
+    mesh = o3d.io.read_triangle_mesh(ply_path)
+    if len(mesh.vertices) > 0:
+        if not mesh.has_vertex_normals():
+            mesh.compute_vertex_normals()
+        geom = mesh
+    else:
+        pcd = o3d.io.read_point_cloud(ply_path)
+        if len(pcd.points) == 0:
+            raise RuntimeError(f"Failed to load geometry from {ply_path}")
+        geom = pcd
+
+    o3d.visualization.draw_geometries(
+        [geom],
+        window_name=window_name,
+        width=width,
+        height=height,
+    )
