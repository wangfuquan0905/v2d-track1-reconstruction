+def normals_edge(
+    normals: np.ndarray,
+    tol: float = 5.0,
+    mask: Optional[np.ndarray] = None,
+) -> np.ndarray:
+    """
+    简化版 normals_edge：
+    法线和邻居法线夹角 > tol(度) 认为是 edge。
+    """
+    assert normals.ndim == 3 and normals.shape[-1] == 3, normals.shape
+    H, W, _ = normals.shape
+    m = _safe_mask(mask, (H, W))
+    edge = np.zeros((H, W), dtype=bool)
+    cos_thresh = np.cos(np.deg2rad(tol))
+
+    def _norm(v):
+        n = np.linalg.norm(v)
+        if n < 1e-6:
+            return None
+        return v / n
+
+    for y in range(H):
+        for x in range(W):
+            if not m[y, x]:
+                continue
+            n0 = _norm(normals[y, x])
+            if n0 is None:
+                continue
+            neighbors = []
+            if x > 0 and m[y, x - 1]:
+                neighbors.append(normals[y, x - 1])
+            if x < W - 1 and m[y, x + 1]:
+                neighbors.append(normals[y, x + 1])
+            if y > 0 and m[y - 1, x]:
+                neighbors.append(normals[y - 1, x])
+            if y < H - 1 and m[y + 1, x]:
+                neighbors.append(normals[y + 1, x])
+            if not neighbors:
+                continue
+            for n2 in neighbors:
+                n2 = _norm(n2)
+                if n2 is None:
+                    continue
+                cos_angle = float(np.clip(np.dot(n0, n2), -1.0, 1.0))
+                if cos_angle < cos_thresh:
+                    edge[y, x] = True
+                    break
+    return edge
