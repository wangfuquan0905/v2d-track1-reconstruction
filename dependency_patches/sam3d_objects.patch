+def points_to_normals(
+    pointmap: np.ndarray,
+    mask: Optional[np.ndarray] = None,
+) -> Tuple[np.ndarray, np.ndarray]:
+    """
+    从点云图 (H, W, 3) 估计法线。使用简单的 cross(dx, dy)。
+    返回 normals, normals_mask。
+    """
+    assert pointmap.ndim == 3 and pointmap.shape[-1] == 3, pointmap.shape
+    H, W, _ = pointmap.shape
+    if mask is None:
+        mask = np.ones((H, W), dtype=bool)
+    else:
+        mask = mask.astype(bool)
+
+    normals = np.zeros_like(pointmap, dtype=np.float32)
+    normals_mask = np.zeros((H, W), dtype=bool)
+    p = pointmap
+
+    for y in range(1, H - 1):
+        for x in range(1, W - 1):
+            if not (
+                mask[y, x]
+                and mask[y, x - 1]
+                and mask[y, x + 1]
+                and mask[y - 1, x]
+                and mask[y + 1, x]
+            ):
+                continue
+            v1 = p[y, x + 1] - p[y, x - 1]
+            v2 = p[y + 1, x] - p[y - 1, x]
+            n = np.cross(v1, v2)
+            norm = np.linalg.norm(n)
+            if norm < 1e-6:
+                continue
+            n = n / norm
+            normals[y, x] = n
+            normals_mask[y, x] = True
+
+    return normals, normals_mask
+
