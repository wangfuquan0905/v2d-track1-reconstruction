+# ---- 替代 kaolin.utils.testing.check_tensor 的轻量实现 ----
+def check_tensor(tensor, shape, throw=True, name="tensor"):
+    """轻量级 shape 检查，兼容原 check_tensor 的常见用法。
+
+    Args:
+        tensor: 要检查的 torch.Tensor。
+        shape: 期望 shape，元组形式，某一维用 None 表示“不关心”，
+            比如 (None, 3) 表示任意 batch_size x 3。
+        throw: 如果为 True，shape 不匹配时抛 AssertionError；
+            如果为 False，返回 False。
+        name: 出错信息里用的名字。
+
+    Returns:
+        True / False，表示是否匹配（当 throw=False 时）。
+    """
+    if not torch.is_tensor(tensor):
+        if throw:
+            raise AssertionError(f"{name} is not a torch.Tensor")
+        return False
+
+    if tensor.dim() != len(shape):
+        if throw:
+            raise AssertionError(
+                f"{name} should have {len(shape)} dims, got {tensor.dim()} with shape {tuple(tensor.shape)}"
+            )
+        return False
+
+    for i, s in enumerate(shape):
+        if s is None:
+            continue
+        if tensor.shape[i] != s:
+            if throw:
+                raise AssertionError(
+                    f"{name} dim {i} should be {s}, got {tensor.shape[i]} (full shape {tuple(tensor.shape)})"
+                )
+            return False
+
+    return True
