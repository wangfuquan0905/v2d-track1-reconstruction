@@ -46,6 +46,20 @@ FOUNDATIONPOSE_SELECTION_DTYPES = {
 FOUNDATIONPOSE_REACQUISITION_LATENCY_UNKNOWN = np.iinfo(np.uint16).max
 
 
+def serialized_centroid_distance(value: float, observed_pixels: int, rendered_pixels: int) -> float:
+    """Represent an undefined silhouette centroid with the schema's NaN sentinel.
+
+    Candidate filtering retains +inf internally to reject unsupported candidates.
+    Only serialization changes; poses, rankings and reliability are untouched.
+    """
+    value=float(value)
+    if np.isposinf(value) and (observed_pixels==0 or rendered_pixels==0):
+        return float('nan')
+    if np.isinf(value):
+        raise ValueError('Unexpected infinite centroid distance with visible support')
+    return value
+
+
 def validate_foundationpose_selection_metadata(metadata: Mapping[str, Any], label: str, camera_order: list[int] | None = None) -> None:
     if metadata.get("foundationpose_selection_revision") != FOUNDATIONPOSE_SELECTION_REVISION:
         raise ValueError(f"{label} has unsupported FoundationPose selection revision: {metadata.get('foundationpose_selection_revision')}")
